# Fortnite AI Coach - example environment file.
# The Gemini API key is NOT read from this file.
# Paste your key in the app: Settings -> Gemini -> API key. It is stored in
# Windows Credential Manager (via keyring), never in plain text.

# Optional: override where the app stores its database and cache.
# FORTNITE_COACH_HOME=C:\Users\you\FortniteCoachData

# Optional: explicit path to ffmpeg/ffprobe if they are not on PATH.
# FORTNITE_COACH_FFMPEG=C:\ffmpeg\bin\ffmpeg.exe
# FORTNITE_COACH_FFPROBE=C:\ffmpeg\bin\ffprobe.exe
