/* Tokens like @BG are replaced by ui/theme.py */
QWidget {
    background: transparent;
    color: @TEXT;
    font-size: 10pt;
}
QMainWindow, #Root { background: @BG; }
QToolTip {
    background: @PANEL_HOVER; color: @TEXT; border: 1px solid @BORDER;
    padding: 6px 8px; border-radius: 6px;
}

/* ---------- Sidebar ---------- */
#Sidebar { background: @PANEL_DARK; border: none; }
#SidebarLogo { font-size: 14pt; font-weight: 700; color: @TEXT; }
#SidebarLogoAccent {
    font-size: 8pt; font-weight: 700; letter-spacing: 2px; color: @PURPLE;
}
#SidebarSection { color: @TEXT_FAINT; font-size: 8pt; font-weight: 700; letter-spacing: 1px; padding: 10px 14px 4px 14px; }
QPushButton#NavButton {
    text-align: left; padding: 9px 14px; border: none; border-radius: 8px;
    background: transparent; color: @TEXT_MUTED; font-weight: 500;
}
QPushButton#NavButton[rtl="true"] { text-align: right; }
QPushButton#NavButton:hover { background: @PANEL_HOVER; color: @TEXT; }
QPushButton#NavButton:checked {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 rgba(139,92,246,0.26), stop:1 rgba(34,197,94,0.06));
    color: @TEXT;  /* no weight change: Qt sizes the button with the normal weight, bold would clip */
}

/* ---------- Status pill ---------- */
#StatusPill { border-radius: 10px; padding: 6px 10px; font-size: 9pt; font-weight: 600; }
#StatusPill[state="ok"]    { background: rgba(34,197,94,0.14);  color: @GREEN; }
#StatusPill[state="warn"]  { background: rgba(245,158,11,0.14); color: @AMBER; }
#StatusPill[state="error"] { background: rgba(239,68,68,0.14);  color: @RED; }
#StatusPill[state="off"]   { background: @PANEL_HOVER;          color: @TEXT_MUTED; }

/* ---------- Page ---------- */
#PageTitle { font-size: 20pt; font-weight: 700; color: @TEXT; }
#PageSubtitle { color: @TEXT_MUTED; font-size: 10pt; }
#DevBadge {
    background: rgba(139,92,246,0.16); color: #C4B5FD; border-radius: 8px;
    padding: 3px 8px; font-size: 8pt; font-weight: 700;
}
QScrollArea { border: none; background: transparent; }
QScrollArea > QWidget > QWidget { background: transparent; }

/* ---------- Cards ---------- */
#Card { background: @PANEL; border: 1px solid @BORDER; border-radius: 14px; }
#CardTitle { font-size: 11pt; font-weight: 600; color: @TEXT; }
#CardSubtitle { color: @TEXT_MUTED; font-size: 9pt; }
#StatValue { font-size: 22pt; font-weight: 700; color: @TEXT; }
#StatValue[empty="true"] { font-size: 11pt; font-weight: 600; color: @TEXT_FAINT; }
#StatLabel { color: @TEXT_MUTED; font-size: 9pt; font-weight: 600; }
#StatHint { color: @TEXT_FAINT; font-size: 8pt; }
#AccentBar { border-radius: 2px; }

/* ---------- Empty state ---------- */
#EmptyTitle { font-size: 12pt; font-weight: 600; color: @TEXT; }
#EmptyText { color: @TEXT_MUTED; }

/* ---------- Inputs ---------- */
QPushButton {
    background: @PANEL_HOVER; border: 1px solid @BORDER; border-radius: 8px;
    padding: 8px 16px; color: @TEXT; font-weight: 600;
}
QPushButton:hover { border-color: @PURPLE; }
QPushButton:disabled { color: @TEXT_FAINT; border-color: @BORDER; background: @PANEL; }
QPushButton#PrimaryButton {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 @PURPLE, stop:1 @GREEN);
    border: none; color: white;
}
QPushButton#PrimaryButton:disabled { background: @PANEL_HOVER; color: @TEXT_FAINT; }
QPushButton#DangerButton { color: @RED; }
QPushButton#DangerButton:disabled { color: @TEXT_FAINT; }
QLineEdit, QComboBox, QSpinBox {
    background: @PANEL_DARK; border: 1px solid @BORDER; border-radius: 8px;
    padding: 7px 10px; color: @TEXT; selection-background-color: @PURPLE;
}
QLineEdit:focus, QComboBox:focus, QSpinBox:focus { border-color: @PURPLE; }
QComboBox QAbstractItemView {
    background: @PANEL; border: 1px solid @BORDER; selection-background-color: @PANEL_HOVER;
}
QProgressBar {
    background: @PANEL_DARK; border: none; border-radius: 5px; height: 10px; text-align: center; color: transparent;
}
QProgressBar::chunk {
    border-radius: 5px;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 @PURPLE, stop:1 @GREEN);
}
QScrollBar:vertical { background: transparent; width: 10px; margin: 2px; }
QScrollBar::handle:vertical { background: @BORDER; border-radius: 4px; min-height: 30px; }
QScrollBar::handle:vertical:hover { background: @TEXT_FAINT; }
QScrollBar::add-line, QScrollBar::sub-line { height: 0; }

/* ---------- Levels / findings ---------- */
#LevelBig { font-size: 22pt; font-weight: 700; color: @TEXT; }
#LevelSmall { font-size: 13pt; font-weight: 700; color: @TEXT; }
#TierBadge { border-radius: 8px; padding: 3px 9px; font-size: 8pt; font-weight: 700; background: @PANEL_HOVER; color: @TEXT_MUTED; }
#TierBadge[tier="silver"] { color: #CBD5E1; }
#TierBadge[tier="gold"] { color: #FBBF24; background: rgba(251,191,36,0.12); }
#TierBadge[tier="platinum"] { color: #5EEAD4; background: rgba(94,234,212,0.12); }
#TierBadge[tier="diamond"] { color: #93C5FD; background: rgba(147,197,253,0.12); }
#TierBadge[tier="master"] { color: #C4B5FD; background: rgba(139,92,246,0.18); }
#TierBadge[tier="legend"] { color: #86EFAC; background: rgba(34,197,94,0.16); }
#TierBadge[tier="bronze"] { color: #D6A274; background: rgba(214,162,116,0.12); }
QProgressBar#XpBar { background: @PANEL_DARK; border-radius: 4px; }
QProgressBar#XpBar::chunk { border-radius: 4px; background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 @PURPLE, stop:1 @GREEN); }
#FindingGood, #FindingMistake { background: @PANEL_DARK; border-radius: 10px; border: 1px solid @BORDER; }
#FindingGood { border-left: 3px solid @GREEN; }
#FindingMistake { border-left: 3px solid @RED; }
#EvidenceFrame { background: #08090B; border-radius: 6px; color: @TEXT_FAINT; }
#Timestamp { font-weight: 700; color: @PURPLE_LIGHT; font-size: 11pt; }
#FindingTitle { font-weight: 600; }
#XpBadge { color: @GREEN; font-weight: 700; }
#SeverityBadge { color: @AMBER; font-weight: 700; }
#Banner { border-radius: 12px; padding: 12px 16px; font-weight: 700; font-size: 11pt;
          background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 rgba(139,92,246,0.35), stop:1 rgba(34,197,94,0.25)); }
#Notice { border-radius: 10px; padding: 10px 14px; background: rgba(245,158,11,0.10); color: #FCD34D; }
QListWidget { background: @PANEL_DARK; border: 1px solid @BORDER; border-radius: 10px; padding: 4px; }
QListWidget::item { padding: 8px; border-radius: 6px; }
QListWidget::item:selected { background: @PANEL_HOVER; color: @TEXT; }

#ExerciseCard { background: @PANEL; border: 1px solid @BORDER; border-radius: 14px; }
#ReasonBox { background: rgba(139,92,246,0.10); border-radius: 8px; padding: 8px 10px; color: #DDD6FE; }

QTableWidget { background: @PANEL_DARK; border: 1px solid @BORDER; border-radius: 10px; gridline-color: @BORDER; }
QHeaderView::section { background: @PANEL_HOVER; color: @TEXT_MUTED; border: none; padding: 6px; font-weight: 600; }
QTableCornerButton::section { background: @PANEL_HOVER; border: none; }
